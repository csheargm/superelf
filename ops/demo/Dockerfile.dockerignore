# Whitelist: everything is excluded, then only the code the demo node runs is let back in.
*
!web.mjs
!REVISION
!package.json
!superelf.md
!version-notes.json
!lib
!web
!tools
!workspace.example
!bible-data
# built-in app PAGES only (moved to builtin-apps/ by the Dockerfile); never their data or meta
!workspace/apps/*/index.html
!shared-apps/*/index.html
!backup.sh
!restore.sh
!ops/demo/entrypoint.sh
!ops/demo/config.demo.json
!ops/demo/ollama-models.json
!ops/private/config.private.json
**/.DS_Store
**/*.log
**/.env
**/config.json
**/*.pem
**/*.key
shared-apps/.versions
