# Copy to .env (chmod 600). Never commit .env. · 复制为 .env，切勿提交
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Install connector)
TUNNEL_TOKEN=
# Ollama API key for https://ollama.com (Account > Keys) — the demo's only AI lane
OLLAMA_API_KEY=
# Host paths (defaults shown; rebuild-demo.sh uses the same)
DEMO_DATA_DIR=./data
BACKUP_PASS_FILE=/etc/superelf-demo/backup-pass
RCLONE_CONFIG_DIR=/etc/superelf-demo/rclone
# Nightly backup destination (rclone remote) and how many to keep
BACKUP_REMOTE=gdrive:superelf-demo-backups
BACKUP_KEEP=7
# The data disk size rebuild-demo.sh makes, and the most the container accepts as "capped"
DEMO_DISK_GB=1
DEMO_DISK_MAX_GB=20
